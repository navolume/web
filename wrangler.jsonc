{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "navolume-waitlist",
      "database_id": "a312c1e6-5864-4858-aad8-301515df4f12"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
